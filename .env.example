PORT=4173
SILO_DATABASE=./data/silo.db
# Any OpenAI-compatible chat-completions provider can power specialist generation.
SILO_AI_BASE_URL=https://your-model-provider.example/v1
SILO_AI_API_KEY=replace-me
SILO_AI_MODEL=your-code-model
# Trusted coordinator: plans domain briefs and shared contracts before specialists code.
# These may point at the shared provider above or a separately governed model endpoint.
SILO_PLANNER_BASE_URL=https://your-model-provider.example/v1
SILO_PLANNER_API_KEY=replace-me
SILO_PLANNER_MODEL=your-planning-model
SILO_ENV=production
# Production identity (OIDC discovery + JWKS validation)
SILO_OIDC_ISSUER=https://identity.example.com
SILO_OIDC_AUDIENCE=silo-api
# Shared event fan-out and dedicated workers
SILO_REDIS_URL=rediss://user:password@redis.example.com:6380/0
SILO_WORKER_SECRET=replace-with-at-least-32-random-bytes
SILO_API_URL=https://silo.example.com

# Optional provider isolation: each specialist can use separate credentials/model.
# SILO_AI_DATABASE_BASE_URL=https://provider-a.example/v1
# SILO_AI_DATABASE_API_KEY=replace-me
# SILO_AI_DATABASE_MODEL=database-code-model
# Repeat the three variables with AUTH, FRONTEND, INFRASTRUCTURE,
# INTELLIGENCE, and BILLING for complete provider isolation.
SILO_MAX_TOOL_ROUNDS=12
# Dependency/network mutation stays disabled unless the dedicated worker is isolated.
SILO_ALLOW_DEPENDENCIES=false
SILO_ALLOW_NETWORK=false
